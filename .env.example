# ── GR Scale Website — Environment Variables ──
# Add these in Vercel → gr-scale-website → Settings → Environment Variables, then redeploy.
# Every one is optional: until it is set, the matching button just stays hidden.

# The AI phone line (Twilio number answered by Ava on Vapi), e.g. +18135551234
NEXT_PUBLIC_AI_PHONE=

# Stripe payment links (Stripe → Payment Links → Create)
NEXT_PUBLIC_STRIPE_SETUP=
NEXT_PUBLIC_STRIPE_MONTHLY=

# Optional backup for the forms (leads already go to Day OS → Biz → GR Scale)
NEXT_PUBLIC_FORMSPREE_ID=
